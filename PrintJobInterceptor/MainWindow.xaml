<Window x:Class="PrintJobInterceptor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PrintJobInterceptor.ViewModels"
        Title="Print Job Interceptor" Height="400" Width="800">

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedJobs" Source="{Binding PrintJobs}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupId" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Window.DataContext>
        <vm:ViewModelMain />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid ItemsSource="{Binding Source={StaticResource GroupedJobs}}"
                  SelectedItem="{Binding SelectedJob}"
                  AutoGenerateColumns="False"
                  Grid.Row="0"
                  IsReadOnly="True"
                  Margin="0,0,0,10">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold" FontSize="14"
                                       Text="Group: {Binding Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Document" Binding="{Binding DocumentName}" />
                <DataGridTextColumn Header="User" Binding="{Binding User}" />
                <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" />
                <DataGridTextColumn Header="Pages" Binding="{Binding TotalPages}" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Grid.Row="1">
            <Button Content="Pause" Command="{Binding PauseCommand}" Margin="5"/>
            <Button Content="Resume" Command="{Binding ResumeCommand}" Margin="5"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
